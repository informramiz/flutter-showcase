  "fixed_sql": [
    {
      "name": "cached_meals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_meals\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"thumbnail_url\" TEXT NOT NULL, \"category\" TEXT NULL, \"area\" TEXT NULL, \"instructions\" TEXT NULL, \"tags\" TEXT NOT NULL DEFAULT '', \"detail_fetched_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "meal_ingredients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_ingredients\" (\"meal_id\" TEXT NOT NULL REFERENCES cached_meals (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"measure\" TEXT NOT NULL, PRIMARY KEY (\"meal_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "cached_queries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_queries\" (\"query_key\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"query_key\"));"
        }
      ]
    },
    {
      "name": "query_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"query_results\" (\"query_key\" TEXT NOT NULL REFERENCES cached_queries (query_key) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"meal_id\" TEXT NOT NULL REFERENCES cached_meals (id), PRIMARY KEY (\"query_key\", \"position\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    },
    {
      "name": "favourites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favourites\" (\"meal_id\" TEXT NOT NULL REFERENCES cached_meals (id), \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"meal_id\"));"
        }
      ]
    },
    {
      "name": "plan_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plan_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"meal_id\" TEXT NOT NULL REFERENCES cached_meals (id), \"day\" INTEGER NOT NULL, \"slot\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"reminder_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reminder_enabled\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "shopping_checks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_checks\" (\"item_key\" TEXT NOT NULL, PRIMARY KEY (\"item_key\"));"
        }
      ]
    },
    {
      "name": "collections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"collections\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "collection_meals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"collection_meals\" (\"collection_id\" INTEGER NOT NULL REFERENCES collections (id) ON DELETE CASCADE, \"meal_id\" TEXT NOT NULL REFERENCES cached_meals (id), \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"collection_id\", \"meal_id\"));"
        }
      ]
    }
